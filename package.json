{
  "name": "dsh-noteboard",
  "version": "0.2.2",
  "description": "Noteboard for the dsh web GUI: a workspace-wide infinite canvas of Markdown sticky notes (.noteboard/), with multi-canvas layouts, tag rearrange, conversation text capture, and an AI distill path.",
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshots.json",
    "screenshots"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "noteboard",
    "canvas"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "lucide-react": "^1.41.0",
    "markdown-it": "^15.0.1",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boogoo619/dsh-noteboard.git"
  },
  "bugs": {
    "url": "https://github.com/boogoo619/dsh-noteboard/issues"
  },
  "homepage": "https://github.com/boogoo619/dsh-noteboard#readme"
}
